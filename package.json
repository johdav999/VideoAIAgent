{
  "name": "video-ai-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Windows-first video production service foundation for Virtual Company",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johdav999/VideoAIAgent.git"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/api/main.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/api/main.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/api.test.mjs tests/adapter.test.mjs tests/process.test.mjs tests/jobs.test.mjs tests/native.test.mjs",
    "browser:install": "node --env-file-if-exists=.env scripts/browser.mjs",
    "film:new": "node --env-file-if-exists=.env scripts/film.mjs new",
    "film:render": "node --env-file-if-exists=.env scripts/film.mjs render",
    "render:sample": "node --env-file-if-exists=.env scripts/film.mjs sample",
    "doctor:render": "node --env-file-if-exists=.env scripts/doctor.mjs --render",
    "test:render": "node --env-file-if-exists=.env scripts/render-acceptance.mjs",
    "test:api-render": "node --env-file-if-exists=.env scripts/api-acceptance.mjs",
    "cinetic": "node --env-file-if-exists=.env scripts/cinetic.mjs",
    "test:cinetic": "node --env-file-if-exists=.env scripts/native-acceptance.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/layout-utils": "4.0.529",
    "@remotion/noise": "4.0.529",
    "@remotion/paths": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@remotion/shapes": "4.0.529",
    "gsap": "3.14.2",
    "hyperframes": "0.8.79",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "remotion": "4.0.529",
    "tar": "7.5.22",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
